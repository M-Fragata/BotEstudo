generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum AuthMethod {
  EMAIL
  GOOGLE
  APPLE
}

enum QuizStatus {
  IN_PROGRESS
  COMPLETED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String?
  authMethod   AuthMethod   @default(EMAIL)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  disciplines  Discipline[]
  materials    StudyMaterial[]
  quizzes      Quiz[]
  sessions     QuizSession[]
  stats        UserStat[]
}

model Discipline {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String?
  tone      String?
  retention Float          @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  materials StudyMaterial[]
  quizzes   Quiz[]

  @@index([userId])
}

model StudyMaterial {
  id           String     @id @default(cuid())
  userId       String
  disciplineId String
  title        String
  content      String?    @db.Text
  fileUrl      String?
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  quizzes      Quiz[]

  @@index([userId])
}

model Quiz {
  id           String     @id @default(cuid())
  userId       String
  disciplineId String
  materialId   String?
  title        String
  score        Float?
  correctCount Int?
  status       QuizStatus @default(IN_PROGRESS)
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  material     StudyMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  questions    Question[]
  sessions     QuizSession[]

  @@index([userId])
  @@index([disciplineId])
}

model Question {
  id                String       @id @default(cuid())
  quizId            String
  position          Int          @default(1)
  prompt            String       @db.Text
  context           String?      @db.Text
  options           Json
  correctOptionId   String
  lastAnswerCorrect Boolean?
  quiz              Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers           UserAnswer[]

  @@index([quizId])
}

model QuizSession {
  id           String       @id @default(cuid())
  userId       String
  quizId       String
  currentIndex Int          @default(0)
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers      UserAnswer[]

  @@index([userId])
  @@index([quizId])
}

model UserAnswer {
  id               String      @id @default(cuid())
  sessionId        String
  questionId       String
  selectedOptionId String
  isCorrect        Boolean
  session          QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
}

model UserStat {
  id             String    @id @default(cuid())
  userId         String
  disciplineId   String?
  questionsDone  Int       @default(0)
  questionsRight Int       @default(0)
  studyMinutes   Int       @default(0)
  weekStart      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
}